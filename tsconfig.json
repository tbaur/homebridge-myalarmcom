{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Source text embedded in the maps rather than referenced from them.
    // `src/` is not published, so a map whose `sources` point at `../../src/*.ts`
    // resolves to nothing on a user's machine — the maps ship, and are useless.
    // Embedding makes them self-contained, so a stack trace in someone's
    // Homebridge log resolves to real TypeScript lines, which is the whole
    // reason to ship maps for a plugin that is debugged remotely.
    "inlineSources": true,
    "moduleResolution": "node",
    "types": ["node"],
    // Suppresses TS5107 for moduleResolution=node10, which stops working in
    // TypeScript 7. Migrating to node16 means handling homebridge being ESM
    // while this package is CommonJS, so it is a deliberate follow-up rather
    // than a silent deferral. Pin `typescript` below 7 until it is done.
    "ignoreDeprecations": "6.0",
    "allowSyntheticDefaultImports": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "coverage", "tests"]
}
